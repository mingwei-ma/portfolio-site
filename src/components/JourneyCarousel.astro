---
// A hand-drawn line paired with a step carousel. Each step is a numbered
// point along the curve (computed at runtime via getPointAtLength so it
// always matches the path exactly); the line progressively draws from the
// start up to the active step as the user clicks through.
interface Step {
  step: string;
  title: string;
  body: string;
}
interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
---
<div class="journey-carousel">
  <svg class="journey" viewBox="0 0 1000 210" overflow="visible" role="img" aria-label="A hand-drawn line with a numbered point for each step below. It draws further along the path as you step through them.">
    <path class="jc-track" d="M 40 152 C 150 152 168 72 268 90 C 356 106 366 178 460 154 C 520 139 520 92 566 96 C 616 100 622 158 572 162 C 522 166 520 116 566 106 C 654 84 712 150 806 116 C 872 92 902 96 936 78"></path>
    <path class="jc-line" pathLength="100" d="M 40 152 C 150 152 168 72 268 90 C 356 106 366 178 460 154 C 520 139 520 92 566 96 C 616 100 622 158 572 162 C 522 166 520 116 566 106 C 654 84 712 150 806 116 C 872 92 902 96 936 78"></path>
  </svg>

  <div class="jc-body">
    <button type="button" class="jc-arrow jc-prev" aria-label="Previous step" disabled>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
    </button>

    <div class="jc-slides">
      {steps.map((s, i) => (
        <article class="jc-slide card" id={`jc-slide-${i}`} hidden={i !== 0}>
          <span class="card-kicker">{s.step}</span>
          <span class="card-title">{s.title}</span>
          <p class="card-body">{s.body}</p>
        </article>
      ))}
    </div>

    <button type="button" class="jc-arrow jc-next" aria-label="Next step">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"></path></svg>
    </button>
  </div>
</div>

<script>
  function initJourneyCarousel() {
    const root = document.querySelector<HTMLElement>('.journey-carousel');
    if (!root) return;
    const svg = root.querySelector<SVGSVGElement>('.journey');
    const path = root.querySelector<SVGPathElement>('.jc-line');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.jc-slide'));
    const prevBtn = root.querySelector<HTMLButtonElement>('.jc-prev');
    const nextBtn = root.querySelector<HTMLButtonElement>('.jc-next');
    if (!svg || !path || slides.length === 0) return;

    const count = slides.length;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Compute each step's point along the actual rendered curve, evenly spaced
    // from start (fraction 0) to end (fraction 1).
    const totalLength = path.getTotalLength();
    const points = Array.from({ length: count }, (_, i) => {
      const frac = count === 1 ? 0 : i / (count - 1);
      return path.getPointAtLength(totalLength * frac);
    });

    const svgNS = 'http://www.w3.org/2000/svg';
    const markers: SVGCircleElement[] = [];
    const numbers: SVGTextElement[] = [];
    const markerGroups: SVGGElement[] = [];
    points.forEach((pt, i) => {
      const g = document.createElementNS(svgNS, 'g');
      g.setAttribute('class', 'jc-marker');
      g.setAttribute('tabindex', '0');
      g.setAttribute('role', 'button');
      g.setAttribute('aria-label', `Go to step ${i + 1}`);

      // Larger invisible circle so the click/tap target isn't limited to the
      // small visible dot.
      const hit = document.createElementNS(svgNS, 'circle');
      hit.setAttribute('class', 'jc-hit');
      hit.setAttribute('cx', String(pt.x));
      hit.setAttribute('cy', String(pt.y));
      hit.setAttribute('r', '22');
      g.appendChild(hit);

      const c = document.createElementNS(svgNS, 'circle');
      c.setAttribute('class', 'jc-point');
      c.setAttribute('cx', String(pt.x));
      c.setAttribute('cy', String(pt.y));
      c.setAttribute('r', '15');
      g.appendChild(c);
      markers.push(c);

      const t = document.createElementNS(svgNS, 'text');
      t.setAttribute('class', 'jc-num');
      t.setAttribute('x', String(pt.x));
      t.setAttribute('y', String(pt.y));
      t.setAttribute('text-anchor', 'middle');
      t.setAttribute('dominant-baseline', 'central');
      t.textContent = String(i + 1);
      g.appendChild(t);
      numbers.push(t);

      svg.appendChild(g);
      markerGroups.push(g);
    });

    let active = 0;

    const render = () => {
      const frac = count === 1 ? 1 : active / (count - 1);
      path.style.strokeDashoffset = String(100 * (1 - frac));

      markers.forEach((m, i) => {
        m.classList.toggle('reached', i <= active);
        m.classList.toggle('current', i === active);
      });
      numbers.forEach((n, i) => {
        n.classList.toggle('reached', i <= active);
        n.classList.toggle('current', i === active);
      });

      slides.forEach((s, i) => {
        s.hidden = i !== active;
      });

      if (prevBtn) prevBtn.disabled = active === 0;
      if (nextBtn) nextBtn.disabled = active === count - 1;
    };

    const goTo = (i: number) => {
      active = Math.max(0, Math.min(count - 1, i));
      render();
    };

    markerGroups.forEach((g, i) => {
      g.addEventListener('click', () => goTo(i));
      g.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          goTo(i);
        }
      });
    });
    prevBtn?.addEventListener('click', () => goTo(active - 1));
    nextBtn?.addEventListener('click', () => goTo(active + 1));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') goTo(active + 1);
      if (e.key === 'ArrowLeft') goTo(active - 1);
    });

    // Reveal (fade in markers/captions) on scroll into view, same trigger the
    // rest of the site's threads use — then render the initial (step 0) state.
    const reveal = () => {
      root.classList.add('drawn');
      render();
    };
    if (reduce) {
      reveal();
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              reveal();
              io.disconnect();
            }
          }
        },
        { threshold: 0.35 }
      );
      io.observe(svg);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initJourneyCarousel);
  } else {
    initJourneyCarousel();
  }
</script>

<style>
  .journey-carousel { display: block; }

  .journey { display: block; width: 100%; height: auto; overflow: visible; margin: 4px 0 20px; }
  .jc-track {
    fill: none; stroke: var(--color-neutral-400); stroke-width: 2.4;
    stroke-linecap: round; stroke-dasharray: 0.5 8;
  }
  :global(.jc-marker) { cursor: pointer; }
  :global(.jc-hit) { fill: transparent; stroke: none; }
  :global(.jc-marker:hover .jc-point), :global(.jc-marker:focus-visible .jc-point) { stroke: var(--color-accent); stroke-width: 3; }
  :global(.jc-marker:focus-visible) { outline: 2px solid var(--color-accent); outline-offset: 3px; border-radius: 50%; }
  .jc-line {
    fill: none; stroke: var(--color-accent); stroke-width: 2.2;
    stroke-linecap: round; stroke-linejoin: round;
    stroke-dasharray: 100; stroke-dashoffset: 100;
    transition: stroke-dashoffset 1.1s cubic-bezier(.5,0,.2,1);
  }
  :global(.jc-point) {
    fill: var(--color-bg); stroke: var(--color-neutral-400); stroke-width: 2;
    opacity: 0; transform: scale(0.4); transform-box: fill-box; transform-origin: center;
    transition: opacity .4s ease, transform .4s cubic-bezier(.34,1.56,.64,1), stroke .3s ease, fill .3s ease;
  }
  .journey-carousel.drawn :global(.jc-point) { opacity: 1; transform: scale(1); }
  :global(.jc-point.reached) { stroke: var(--color-accent); }
  :global(.jc-point.current) { fill: var(--color-accent); stroke: var(--color-accent); }
  :global(.jc-num) {
    font-family: var(--font-sans); font-size: 16px; font-weight: 600; font-variant-numeric: tabular-nums;
    fill: var(--color-neutral-500); opacity: 0; pointer-events: none;
    transition: opacity .4s ease, fill .3s ease;
  }
  .journey-carousel.drawn :global(.jc-num) { opacity: 1; }
  :global(.jc-num.reached) { fill: var(--color-accent-700); }
  :global(.jc-num.current) { fill: var(--color-bg); font-weight: 600; }

  .jc-body { display: flex; align-items: stretch; gap: var(--space-4); max-width: 640px; margin: 0 auto; }
  .jc-slides { flex: 1; min-width: 0; }
  .jc-slide { min-height: 168px; text-align: left; }
  .jc-slide[hidden] { display: none; }
  .jc-slide .card-kicker { color: var(--color-accent); }

  .jc-arrow {
    flex: none; width: 40px; height: 40px; border-radius: 50%; align-self: center;
    display: flex; align-items: center; justify-content: center;
    background: transparent; border: 1px solid var(--color-divider); color: var(--color-text);
    cursor: pointer;
  }
  .jc-arrow svg { width: 18px; height: 18px; }
  .jc-arrow:hover:not(:disabled) { border-color: var(--color-accent); color: var(--color-accent); }
  .jc-arrow:disabled { opacity: 0.35; cursor: not-allowed; }

  @media (max-width: 640px) {
    .jc-body { gap: var(--space-2); }
    .jc-slide { padding: var(--space-3); }
  }

  @media (prefers-reduced-motion: reduce) {
    .jc-line, :global(.jc-point), :global(.jc-num) { transition: none !important; }
  }
</style>
