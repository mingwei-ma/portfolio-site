---
// Sticky top nav. Above 860px: Work and About are hover/focus dropdowns
// (each trigger links to its first child and stays accent-colored while
// any child page is active; dropdown item labels are pre-split into
// per-letter <span>s for the rainbow hover treatment in global.css).
// At/below 860px the dropdowns and inline links are replaced by a
// hamburger button that reveals a stacked panel, with Work/About as
// native <details> accordions (keyboard/screen-reader support for free).
interface Props {
  current: 'home' | 'professional' | 'personal' | 'about' | 'blog' | 'contact';
}
const { current } = Astro.props;
const isCurrent = (page: string) => (current === page ? 'page' : undefined);
const letters = (text: string) => [...text].map((ch) => (ch.trim() ? ch : { space: true }));
const workActive = current === 'professional' || current === 'personal';
const aboutActive = current === 'about' || current === 'blog';
---
<nav class="navbar">
  <a href="/" class="brand">Mingwei&nbsp;Ma</a>

  <div class="nav-links-desktop">
    <a href="/" class="nav-home" aria-current={isCurrent('home')}>Home</a>

    <div class="navdrop nav-work">
      <a href="/work/professional" aria-current={workActive ? 'page' : undefined}>
        Work
        <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </a>
      <div class="navmenu">
        <a href="/work/professional" aria-current={isCurrent('professional')}>{letters('Professional').map((c) => (typeof c === 'string' ? <span>{c}</span> : ' '))}</a>
        <a href="/work/personal" aria-current={isCurrent('personal')}>{letters('Personal').map((c) => (typeof c === 'string' ? <span>{c}</span> : ' '))}</a>
      </div>
    </div>

    <div class="navdrop nav-about">
      <a href="/about" aria-current={aboutActive ? 'page' : undefined}>
        About
        <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </a>
      <div class="navmenu">
        <a href="/about" aria-current={isCurrent('about')}>{letters('About').map((c) => (typeof c === 'string' ? <span>{c}</span> : ' '))}</a>
        <a href="/blog" aria-current={isCurrent('blog')}>{letters('Field Notes').map((c) => (typeof c === 'string' ? <span>{c}</span> : ' '))}</a>
      </div>
    </div>

    <a href="/contact" class="nav-contact" aria-current={isCurrent('contact')}>Contact</a>
  </div>

  <button id="nav-toggle" class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav-panel" aria-label="Open menu">
    <svg class="icon-burger" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>

  <div id="mobile-nav-panel" class="mobile-nav-panel">
    <a href="/" aria-current={isCurrent('home')}>Home</a>

    <details class="mobile-accordion" open={workActive}>
      <summary class={workActive ? 'current' : undefined}>Work</summary>
      <a href="/work/professional" aria-current={isCurrent('professional')}>Professional</a>
      <a href="/work/personal" aria-current={isCurrent('personal')}>Personal</a>
    </details>

    <details class="mobile-accordion" open={aboutActive}>
      <summary class={aboutActive ? 'current' : undefined}>About</summary>
      <a href="/about" aria-current={isCurrent('about')}>About</a>
      <a href="/blog" aria-current={isCurrent('blog')}>Field Notes</a>
    </details>

    <a href="/contact" aria-current={isCurrent('contact')}>Contact</a>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav-panel');

  if (toggle && panel) {
    const closeMenu = () => {
      toggle.setAttribute('aria-expanded', 'false');
      panel.classList.remove('open');
    };
    const openMenu = () => {
      toggle.setAttribute('aria-expanded', 'true');
      panel.classList.add('open');
    };

    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      if (expanded) closeMenu();
      else openMenu();
    });

    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });

    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (toggle.getAttribute('aria-expanded') === 'true' && !panel.contains(target) && !toggle.contains(target)) {
        closeMenu();
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 860) closeMenu();
    });
  }
</script>
