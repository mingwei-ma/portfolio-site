---
// Hand-drawn, single-stroke phone handset mark for the Contact page hero,
// replacing the generic loop mark there. Same thread/loopmark conventions
// as Loop.astro (viewBox scaled to a similar visual weight, pathLength=100
// for the scroll-draw animation) but its own one-off path per the design
// reference (MIN-190): a sweeping gesture from the earpiece down into the
// handset's cord, knotted and curled like the site's other loop details.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<svg class={`thread loopmark phone-icon ${className ?? ''}`} viewBox="-4 -1 100 60" aria-hidden="true">
  <path class="tl" pathLength="100" d="M 9 6
    C 6 9, 7 13, 12 13
    C 22 13, 24 20, 17 22
    C 13 23, 10 20, 10 18
    C 11 24, 18 32, 26 39
    C 34 46, 44 51, 53 52
    C 58 52.5, 61 50, 60 46
    C 59.3 43, 56 42, 54.5 44.5
    C 53.3 46.5, 55 49, 58 48.5
    C 65 47, 70 41, 68 34
    C 67 30.5, 63 30, 62.5 33
    C 79 39, 87 32, 84 25
    C 83 22.5, 80 22, 80 25"></path>
</svg>
