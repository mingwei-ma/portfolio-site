---
// Hand-drawn, single-stroke phone handset mark for the Contact page hero,
// replacing the generic loop mark there. Same thread/loopmark conventions
// as Loop.astro (pathLength=100 for the scroll-draw animation, accent
// stroke) but its own one-off outline path per the design reference
// (MIN-190): a round earpiece and mouthpiece joined by a smooth neck,
// trailing into a cord curl.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<svg class={`thread loopmark phone-icon ${className ?? ''}`} viewBox="11.9 6 59.1 50.8" aria-hidden="true">
