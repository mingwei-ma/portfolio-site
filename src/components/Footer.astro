    <a class="footlink" href="/assets/Mingwei-Ma-Resume.pdf" target="_blank">Résumé (PDF)</a>
    <div style="font-size: 12px; color: var(--color-neutral-600); margin-top: 4px;">© 2026 Mingwei Ma</div>
  </div>
</footer>
