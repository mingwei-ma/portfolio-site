---
interface Props {
  bordered?: boolean;
}
const { bordered = true } = Astro.props;
---
<footer class="wrap site-foot" style={bordered ? 'border-top: 1px solid var(--color-divider);' : undefined}>
  <div>
    <div style="font-family: var(--font-nav); font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; font-size: 16px;">Mingwei Ma</div>
    <div style="font-size: 13px; font-family: var(--font-nav); color: var(--color-neutral-600); margin-top: 4px;">Product Manager · Open to full-time roles</div>
    <a href="https://www.credly.com/badges/43ee1b52-ec44-4f12-9f74-6249470cb4ca" target="_blank" rel="noopener" title="View PMP certification on Credly" style="display: block; margin-top: 10px;">
      <img src="/assets/pmp-badge.png" alt="PMP Certified badge" width="40" height="40" style="display: block;" />
    </a>
  </div>
  <div class="foot-cols">
    <div class="foot-col"><a class="footlink" href="/">Home</a><a class="footlink" href="/work/product">Work</a></div>
    <div class="foot-col"><a class="footlink" href="/about">About</a><a class="footlink" href="/contact">Contact</a></div>
  </div>
  <div class="foot-col" style="font-size: 14px;">
    <a class="footlink" href="mailto:mingweima98@gmail.com" style="color: var(--color-accent);">mingweima98@gmail.com</a>
    <a class="footlink" href="https://www.linkedin.com/in/mingwei-ma/" target="_blank" rel="noopener" aria-label="LinkedIn" style="display: inline-flex; align-items: center;">
