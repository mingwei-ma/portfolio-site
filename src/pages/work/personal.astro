---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Loop from '../../components/Loop.astro';
import Kicker from '../../components/Kicker.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import JourneyCarousel from '../../components/JourneyCarousel.astro';

const projects = [
  {
    num: '01 · Web app · Work in progress',
    title: 'Outpost',
    tagline: 'A coffee-shop finder for people who work from anywhere.',
    paras: [
      { lead: 'The problem.', text: "Every time I wanted to find somewhere to study or co-work with a friend in NYC, I'd end up with three browser tabs open — Yelp, Google Maps, the café's own website — and still not know if it'd actually work for me. One tells you if the coffee is good. One tells you how far away it is. Nobody tells you whether you can set up for three hours, find an outlet, and hear yourself think." },
      { lead: 'The build.', text: 'I had a product idea and not enough technical expertise. So I learned by doing — leaning on what I know about how projects run, and using Claude to execute. I started with a product brief, built the visual direction and mockups in Claude Design, then handed off a full design package to Claude Code to build a working prototype. Even as a team of one, I set up a Linear project, wrote tickets, and ran a real feedback loop: backlog grooming, prioritization, dependency mapping. It kept Claude and me aligned on the roadmap and gave the whole thing the structure it needed to move fast without getting messy or losing momentum.' },
      { lead: 'The part that surprised me:', text: "coding wasn't the hardest part. The hard part was the strategic thinking — being clear and precise enough about what to build that AI could actually build it well. In the end, it wasn't so different from running an end-to-end project with a full team of designers and developers, just a much smaller standup." },
      { lead: 'Lessons learned.', text: "The tools were the easy part to pick up — Vercel, Supabase, SQL, OpenStreetMap, a handful of integrations. What took more work was developing an instinct for when to go deep and when to stay at the product level. There were moments where I had to resist the urge to just ask Claude to build something, and instead slow down to think through the implications: how does this data model affect what we can show users? What happens to this feature when the database has 10,000 entries instead of 300? That kind of thinking — anticipating downstream consequences before writing a line of code — is something I'd always relied on designers and engineers to do. This project forced me to learn how to do it myself, building confidence to work more fluidly with future project teams." },
      { lead: 'Next up:', text: 'a small beta with real users in NYC, using their feedback to sharpen the data and validate whether Outpost is as useful in practice as it is in theory!' },
    ],
    criteriaLabel: 'Filters on what matters',
    criteria: ['Outlets', 'Strong wifi', 'Lots of seating', 'Laptops welcome', 'Low noise'],
    stack: ['Claude Design', 'Claude Code', 'Vercel', 'Supabase'],
    links: [
      { label: 'Visit the live app →', href: 'https://outpost-cafe-finder-five.vercel.app/', style: 'primary' },
      // "Peek at the code" hidden until the repo goes public — the live app
      // link above already covers previewing it. Add back with the real
      // GitHub URL (https://github.com/mingwei-ma/outpost-cafe-finder) once ready.
    ],
    video: '/assets/outpost-demo.mp4',
    videoPoster: '/assets/outpost-demo-poster.jpg',
    imageLabel: 'Outpost — map & filters view',
    rev: false,
  },
  {
    num: '02 · Craft build',
    title: 'Your next one goes here',
    tagline: "You mentioned a hands-on, physical build — let's give it a home.",
    paras: [
      { lead: 'Placeholder.', text: "Tell me what it is — what you made, why, roughly when, and anything you learned or would do differently. A sentence or two per point is plenty and I'll shape it to match Outpost above." },
    ],
    extraPara: "Drop a photo into the frame and this block reads exactly like a finished feature. If there's a link (a build log, a shop listing, an Instagram post) I'll wire it in too.",
    imageLabel: 'Craft build — add a caption',
    rev: true,
  },
];
---
<BaseLayout title="Personal — Mingwei Ma" description="Side projects Mingwei Ma has built for the fun of it, outside client work.">
  <Nav current="personal" />

  <header class="wrap hero">
    <Loop variant="double" />
    <Kicker text="Off the clock" />
    <h1>Things I've made for the fun of it.</h1>
    <p class="lede">The same instinct that runs a delivery plan also builds side projects on weekends and nights. Here are a few recent builds made possible with AI assistance.</p>
  </header>

  {/* Case study 2 ("Your next one goes here") is a placeholder awaiting real
      content — only show Outpost for now. Change back to projects.map to
      restore it once there's a second project to show. */}
  {projects.slice(0, 1).map((p) => (
    <section class={`wrap feat ${p.rev ? 'rev' : ''}`}>
      <div class="feat-art">
        {p.video ? (
          <div class="plate video-plate" style="aspect-ratio: 1360 / 886; filter: none;">
            <video class="feat-video" src={p.video} poster={p.videoPoster} autoplay muted loop playsinline tabindex="0" role="button" aria-label={`${p.imageLabel} — click to pause or play`} />
            <div class="video-overlay" aria-hidden="true">
              <span class="icon-circle">
                <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
                <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h4v14H6zM14 5h4v14h-4z"></path></svg>
              </span>
            </div>
          </div>
        ) : p.image ? (
          <div class="plate" style="aspect-ratio: 4/3; filter: none;">
            <img src={p.image} alt={p.imageLabel} />
          </div>
        ) : (
          <ImagePlaceholder label={p.imageLabel} aspect="4/3" />
        )}
        <div class="art-note">{p.imageLabel}</div>
        {p.criteria && (
          <div class="crit">
            <span class="crit-label" style="width: 100%;">{p.criteriaLabel}</span>
            {p.criteria.map((c) => <span class="tag tag-outline">{c}</span>)}
          </div>
        )}
        {p.stack && (
          <div class="stackline">
            <span class="stack-label">Built with</span>
            {p.stack.map((s) => <span class="tag tag-neutral">{s}</span>)}
          </div>
        )}
        {p.links && (
          <div class="feat-links">
            {p.links.map((l) => (
              <a href={l.href} target="_blank" class={`btn btn-${l.style} feat-btn`}>{l.label}</a>
            ))}
          </div>
        )}
      </div>
      <div>
        <span class="feat-num">{p.num}</span>
        <h2>{p.title}</h2>
        <p class="tagline">{p.tagline}</p>
        {p.paras.length > 1 ? (
          <JourneyCarousel steps={p.paras.map((para, i) => ({
            step: `Part 0${i + 1} / 0${p.paras.length}`,
            title: para.lead,
            body: para.text,
          }))} />
        ) : (
          p.paras.map((para) => (
            <p><strong>{para.lead}</strong> {para.text}</p>
          ))
        )}
        {p.extraPara && <p>{p.extraPara}</p>}
      </div>
    </section>
  ))}

  {/* Bottom CTA hidden for now alongside case study 2 — flip to true to restore. */}
  {false && (
    <section class="wrap cta-section">
      <Loop variant="flourish" />
      <h2 class="cta-h2">Got an idea you want built?</h2>
      <p class="lede cta-lede">The professional work is where the rigor lives — but I'm always up for a good side project. Say hi.</p>
      <div class="cta-ctas">
        <a href="/contact" class="btn btn-primary cta-btn">Get in touch →</a>
        <a href="/work/professional" class="btn btn-secondary cta-btn">See the professional work</a>
      </div>
    </section>
  )}

  <Footer />
</BaseLayout>

<style>
  .hero { text-align: center; padding-top: 88px; padding-bottom: 48px; max-width: 780px; margin: 0 auto; }
  .hero h1 { font-size: 52px; line-height: 1.08; margin: 20px 0 22px; font-weight: 400; }

  .feat { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-8); align-items: start; padding: var(--space-8) 0; border-top: 1px solid var(--color-divider); }
  .feat.rev .feat-art { order: 2; }
  .feat-num { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-accent-700); font-family: var(--font-sans); font-variant-numeric: tabular-nums; }
  .feat h2 { font-size: 42px; line-height: 1.02; font-weight: 400; margin: 12px 0 8px; }
  .tagline { font-family: var(--font-heading); font-style: italic; font-size: 22px; line-height: 1.3; color: color-mix(in srgb, var(--color-text) 74%, transparent); margin: 0 0 var(--space-3); }
  .feat p { font-size: 15.5px; line-height: 1.7; color: color-mix(in srgb, var(--color-text) 82%, transparent); }
  .feat p strong { font-weight: 600; color: var(--color-text); }

  .crit { display: flex; flex-wrap: wrap; gap: 8px; margin: var(--space-3) 0 var(--space-4); }
  .crit-label, .stack-label { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-neutral-600); font-family: var(--font-sans); }
  .stackline { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-top: var(--space-4); padding-top: var(--space-3); border-top: 1px solid var(--color-divider); }
  .feat-links { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-6); }
  .feat-btn { font-size: 15px; padding: 12px 24px; }
  .feat-art .plate { width: 100%; filter: none; }
  .feat-video { cursor: pointer; }
  .video-plate { position: relative; }
  .video-overlay { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; }
  .icon-circle {
    width: 60px; height: 60px; border-radius: 50%; background: rgba(0, 0, 0, 0.5);
    display: flex; align-items: center; justify-content: center; color: #fff;
    opacity: 0; transition: opacity 0.2s ease;
  }
  .video-plate:hover .icon-circle, .video-plate.is-paused .icon-circle { opacity: 1; }
  .icon-circle svg { width: 24px; height: 24px; }
  .icon-play { display: none; }
  .video-plate.is-paused .icon-pause { display: none; }
  .video-plate.is-paused .icon-play { display: block; }
  .art-note { font-family: var(--font-sans); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-neutral-600); margin-top: 10px; text-align: right; }

  .cta-section { padding-top: 96px; padding-bottom: 96px; text-align: center; border-top: 1px solid var(--color-divider); margin-top: var(--space-8); }
  .cta-h2 { font-size: 42px; margin: 0 0 18px; font-weight: 400; }
  .cta-lede { max-width: 560px; margin: 0 auto 28px; }
  .cta-ctas { display: flex; gap: var(--space-3); justify-content: center; flex-wrap: wrap; margin-top: var(--space-6); }
  .cta-btn { font-size: 15px; padding: 13px 28px; }

  @media (max-width: 860px) {
    .hero { padding-top: 56px; padding-bottom: 40px; }
    .hero h1 { font-size: 34px; }
    .feat { grid-template-columns: 1fr; gap: var(--space-4); }
    .feat.rev .feat-art { order: 0; }
    .cta-section { padding-top: 56px; padding-bottom: 56px; }
    .cta-h2 { font-size: 28px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLVideoElement>('.feat-video').forEach((video) => {
    const plate = video.closest('.video-plate');
    const toggle = () => (video.paused ? video.play() : video.pause());
    video.addEventListener('play', () => plate?.classList.remove('is-paused'));
    video.addEventListener('pause', () => plate?.classList.add('is-paused'));
    video.addEventListener('click', toggle);
    video.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggle();
      }
    });
  });
</script>
