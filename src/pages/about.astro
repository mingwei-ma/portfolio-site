---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Loop from '../components/Loop.astro';
import Journey from '../components/Journey.astro';
import Kicker from '../components/Kicker.astro';
import { letters } from '../lib/letters';

const process = [
  { step: 'Step 01', title: 'Listen & map', body: 'I meet the people and the project where they are before I touch the plan, learning the goals, the constraints, and where trust needs to be built.' },
  { step: 'Step 02', title: 'Create & execute the plan', body: 'A plan the team helped shape and actually believes in with clear owners, honest dates, visible risks & mitigations.' },
  { step: 'Step 03', title: 'Unblock daily', body: "I chase down answers and clear the path, protecting my team's time so they can do what they do best." },
  { step: 'Step 04', title: 'Land & learn', body: 'Ship it, close it cleanly, leaving the team with practices that outlast the project and leaving the client excited to start a new engagement.' },
];

const processColors = ['#edafc0', '#dec376', '#eebaa0', '#b6cd9c'];

const credentials = [
  'PMP Certified',
  '5+ years leading delivery',
  '$2.6M+ Portfolio Value',
  'Hands-on AI Fluency',
  'Webby-nominated work',
  'Trained in Executive Communications',
];

const timeline = [
  { year: 'Oct 2025 – Apr 2026', role: 'Product Manager · SUBSCRIBE', org: 'Fintech SaaS', body: 'Architected a standardized Asana workspace from the ground up — drove 100% adoption across 10 teams and cleared a 4-year-old backlog in weeks.' },
  { year: 'Nov 2024 – Oct 2025', role: 'Senior Digital Project Manager · Wide Eye', org: 'Creative agency', body: 'Led $2.6M+ of custom brand and web work across 10+ clients, running resourcing for blended teams and lifting efficiency 20%.' },
  { year: 'Nov 2023 – Nov 2024', role: 'Senior Digital Project Manager · Studio Simpatico', org: 'Creative agency', body: 'Managed 7+ web builds and 20 retainer clients, and led the change from Basecamp to Linear to raise team velocity.' },
  { year: 'Jan 2022 – Nov 2023', role: 'Project Manager · Studio Simpatico', org: 'Creative agency', body: 'Supported 25+ retainer clients across DTC, wellness, fintech, and non-profit sectors, and converted 7+ project clients into long-term retainers.' },
  { year: 'Sep 2021 – Jan 2022', role: 'Project Manager · Vaudeville Ventures', org: 'Marketing agency', body: 'Ran project plans, budget trackers, and resource-capacity planning for in-house and freelance teams, keeping marketing deliverables on schedule.' },
  { year: 'Feb 2021 – Sep 2021', role: 'Junior Strategist · Vaudeville Ventures', org: 'Marketing agency', body: 'Coordinated scheduling and reporting across multiple accounts, and helped shape brand strategy that supported market entry for two healthcare and tech clients.' },
];

const toolkit = [
  { label: 'Program & project management', style: 'outline', tags: ['Intake process design', 'Roadmap & backlog prioritization', 'Risk escalation (P0–P4)', 'KPI & status reporting', 'Resource & capacity planning', 'Change management', 'Budget management', 'Agile methodologies'] },
  { label: 'Tools', style: 'neutral', tags: ['Asana', 'Jira', 'Linear', 'Notion', 'Airtable', 'Confluence', 'Excel / MS Office'] },
  { label: 'Stakeholder & creative ops', style: 'outline', tags: ['Discovery workshops', 'Requirements gathering', 'Executive communication', 'Client onboarding', 'Cross-functional collaboration', 'Creative operations'] },
  { label: 'Documentation', style: 'neutral', tags: ['Functional specs', 'Acceptance criteria', 'Operational systems', 'Process documentation', 'SOW writing'] },
];
---
<BaseLayout title="About — Mingwei Ma" description="I'm Mingwei Ma, and I make delivery feel calm. Product Manager with over five years leading cross-functional delivery.">
  <Nav current="about" />

  <header class="wrap hero">
    <div>
      <Loop variant="double" class="hero-loop" />
      <Kicker text="About" />
      <h1>I'm Mingwei. I bridge the gap between big ideas and strict deadlines.</h1>
      <p class="lede">For over five years, I've been the person teams trust to handle their hardest, most tangled projects. Not because I have the fanciest framework, but because I earn their trust quickly and use it to keep everyone from product and engineering, to design, and leadership, moving in the same direction.</p>
    </div>
    <div>
      <div class="plate portrait" style="aspect-ratio: 3/4; filter: none;">
        <img src="/assets/about-portrait.jpg" alt="Portrait of Mingwei Ma" />
      </div>
    </div>
  </header>

  <section class="wrap prose story">
    <p>My road to project management began back when high school group projects needed someone to build the color-coded schedule, empower each team member to contribute their part, and clear the path to deliver A+ work. Since then, I've spent over five years working my way up — from coordinating boutique brand and design projects to managing complex custom web builds at fast-paced agencies and startups.</p>
    <p>I quickly found that my favorite part of the work isn't the Gantt chart; it's the people and the cross-functional collaboration. Getting a skeptical engineer and an anxious client to align, spotting the quiet bottleneck before it breaks a timeline, and translating ambiguous client feedback into clear actionable items for a design team.</p>
    <p>I believe most project problems are trust and communication problems wearing schedule as a disguise. My approach leads with human connection, creating the baseline trust required for strict operational rigor to actually be effective. And when something gets tangled, I don't just log a ticket and wait — I dig into the root cause, bring the team a clear recommendation, and codify the fix into our workflows so we don't solve the same problem twice.</p>
    <p>Lately, I've been deepening my technical and AI fluency by getting hands-on with tools like Claude Design and Claude Code to build things from scratch (including this website!). I don't want to just theorize about emerging tech; I want to speak my engineers' language, understand delivery friction firsthand, and actively find practical ways to leverage AI to make workflows faster and smarter for the whole team.</p>
  </section>

  <section class="wrap section">
    <div class="section-head" style="margin-bottom: var(--space-5);">
      <Kicker text="How I work" />
      <h2>Trust first, then throughput.</h2>
      <p class="lede section-lede">Every engagement is really one thing: getting a project from where it is to where it needs to land.</p>
    </div>
    <Journey />
    <div class="process-grid">
      {process.map((p, i) => (
        <div
          class="card process-card-art"
          style={`--card-head: url('/assets/process-card-${i + 1}-head.png'); --card-body-color: ${processColors[i]};`}
        >
          <div class="process-card-head">
            <span class="card-title">{p.title}</span>
          </div>
          <p class="card-body">{p.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap section" style="text-align: center;">
    <Kicker text="Credentials" />
    <div class="cred-row">
      {credentials.map((c, i) => (
        <span class={`tag ${i === 0 ? 'tag-outline' : 'tag-neutral'} cred-tag`}>{c}</span>
      ))}
    </div>
  </section>

  <section class="wrap section timeline-section">
    <div class="section-head">
      <Loop d="M 4 30 C 30 30 34 8 48 8 C 62 8 62 26 48 26 C 40 26 40 16 50 16 C 66 16 70 30 88 30" />
      <Kicker text="The path here" />
      <h2>Where I've done the work.</h2>
    </div>
    {timeline.map((t) => (
      <div class="tl-row">
        <span class="tl-year">{t.year}</span>
        <div>
          <div class="tl-role">{t.role}</div>
          <div class="tl-org">{t.org}</div>
          <p class="tl-body">{t.body}</p>
        </div>
      </div>
    ))}
  </section>

  <section class="wrap section toolkit-section">
    <div class="section-head">
      <Kicker text="Toolkit" />
      <h2>The skills behind the delivery.</h2>
    </div>
    <div class="toolkit-grid">
      {toolkit.map((group) => (
        <div>
          <div class="kick toolkit-label">{group.label}</div>
          {group.style === 'outline' ? (
            <ul class="toolkit-list">
              {group.tags.map((t) => <li>{t}</li>)}
            </ul>
          ) : (
            <div class="toolkit-tags">
              {group.tags.map((t) => (
                <span class={`tag tag-${group.style}`}>{t}</span>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
    <div class="edu-row">
      <div class="edu-degree">B.S., International Trade &amp; Marketing</div>
      <div class="edu-school">Fashion Institute of Technology (SUNY) · Dec 2019</div>
    </div>
  </section>

  <section class="wrap section cta-section">
    <div class="cta-band">
      <Loop variant="below" />
      <Kicker text="Let's talk" />
      <h2 class="cta-h2">Think we might be a fit?</h2>
      <p class="lede cta-lede">I'd love to hear about the team and the work. Send a note, or take my résumé with you.</p>
      <div class="cta-ctas">
        <a href="/contact" class="btn btn-primary cta-btn"><span class="btn-label">Book a discovery call →</span></a>
        <a href="/assets/Mingwei-Ma-Resume.pdf" target="_blank" class="btn btn-ghost cta-btn cta-btn-icon hover-rainbow">
          <span>{letters('Download résumé').map((c) => (typeof c === 'string' ? <span>{c}</span> : <span> </span>))}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .hero { display: grid; grid-template-columns: 1.3fr 1fr; gap: 56px; align-items: center; padding-top: 88px; padding-bottom: 72px; }
  .hero h1 { font-size: 52px; line-height: 1.08; margin: 20px 0 24px; font-weight: 400; }
  :global(.hero-loop) { margin: 0 0 var(--space-3) 0; }
  .portrait { width: 100%; }

  .story { max-width: 720px; padding-top: 24px; }

  .section { padding-top: 80px; }
  .section-head { text-align: center; margin-bottom: var(--space-6); }
  .section-head h2 { font-size: 36px; margin-top: 14px; font-weight: 400; }

  .section-lede { max-width: 500px; margin: 14px auto 0; font-size: 16px; }
  .process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); }
  .process-card-art {
    border: none; padding: 0; gap: 0; overflow: hidden;
    background-color: var(--card-body-color);
  }
  .process-card-head {
    background-image: var(--card-head);
    background-size: cover; background-position: center;
    padding: var(--space-3);
  }
  .process-card-art .card-title { text-transform: none; letter-spacing: normal; font-size: 16px; display: block; }
  .process-card-art .card-body { margin: 0; padding: var(--space-3); }

  .cred-row { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: var(--space-4); }
  .cred-tag { font-size: 13px; padding: 6px 14px; }

  .timeline-section { max-width: 780px; }
  .tl-role { font-family: var(--font-nav); font-weight: 500; font-size: 17px; }
  .tl-org { font-size: 12.5px; font-family: var(--font-nav); letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-neutral-600); margin: 3px 0 6px; }
  .tl-body { font-size: 14px; line-height: 1.6; margin: 0; font-family: var(--font-body); color: color-mix(in srgb, var(--color-text) 78%, transparent); }

  .toolkit-section { max-width: 860px; }
  .toolkit-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-5) var(--space-8); }
  .toolkit-label { margin-bottom: var(--space-3); }
  .toolkit-tags { display: flex; flex-wrap: wrap; gap: 7px; }
  .toolkit-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 7px; font-size: 13.5px; font-family: var(--font-nav); color: color-mix(in srgb, var(--color-text) 82%, transparent); }
  .edu-row { margin-top: var(--space-6); padding-top: var(--space-4); border-top: 1px solid var(--color-divider); display: flex; flex-wrap: wrap; gap: 4px 16px; align-items: baseline; justify-content: space-between; }
  .edu-degree { font-family: var(--font-nav); font-weight: 500; text-transform: uppercase; letter-spacing: 0.03em; font-size: 14px; }
  .edu-school { font-size: 13px; font-family: var(--font-nav); color: var(--color-neutral-600); }

  .cta-section { padding-top: 96px; text-align: center; }
  .cta-band {
    padding: 110px 48px;
    border-radius: var(--radius-lg);
    background-color: #f0e9df;
    background-image: url('/assets/cta-bg.jpg');
    background-size: cover;
    background-position: center;
  }
  .cta-h2 { font-size: 42px; margin: 18px 0; font-weight: 400; }
  .cta-lede { max-width: 520px; margin: 0 auto var(--space-6); }
  .cta-ctas { display: flex; align-items: flex-start; gap: var(--space-3); justify-content: center; flex-wrap: wrap; }
  .cta-btn { font-size: 15px; padding: 13px 28px; }
  .cta-btn-icon { display: inline-flex; align-items: center; gap: 8px; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; padding-top: 56px; padding-bottom: 40px; text-align: center; }
    .hero h1 { font-size: 34px; }
    :global(.hero-loop) { margin-left: auto; margin-right: auto; }
    .portrait { max-width: 320px; margin: 0 auto; }
    .section { padding-top: 48px; }
    .process-grid { grid-template-columns: 1fr; }
    .tl-row { grid-template-columns: 1fr; }
    .toolkit-grid { grid-template-columns: 1fr; }
    .cta-h2 { font-size: 28px; }
    .cta-band { padding: 52px 24px; }
  }
</style>
