---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Loop from '../components/Loop.astro';
import ThreadRule from '../components/ThreadRule.astro';
import Kicker from '../components/Kicker.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';

const values = [
  { num: '01', title: 'Trust, built fast', body: 'I create the conditions for cross-functional teams and clients to be honest with each other, a non-negotiable for any project to move smoothly. Through 1x1s, light pre-meeting banter, and thoughtful communication, I build relationships that last and trust that allow true collaboration.' },
  { num: '02', title: 'Autonomy, not just administration', body: "When things get tangled, I don't just log a ticket and wait. I investigate the root cause, map out potential solutions for the team, and bring a clear recommendation to leadership. Once resolved, I codify the solution into our workflows so we don't have to solve the same problem twice." },
  { num: '03', title: 'Calm under pressure', body: "The messier the moment, the steadier I get. Creative projects are inherently chaotic, but I stay grounded so teams have the confidence they need to focus on the work and get it over the line. I truly believe there are no obstacles that can't be overcome with clear leadership and teamwork." },
];

const credentials = [
  'PMP · In progress (Q3)',
  '6+ years leading delivery',
  '$2.6M+ Portfolio Value',
  'Hands-on AI Fluency',
  'Webby-nominated work',
  'Trained in Executive Communications',
];

const timeline = [
  { year: 'Oct 2025 – May 2026', role: 'Founding Product Manager · SUBSCRIBE', org: 'Fintech SaaS', body: 'Built the program management function from scratch — intake, roadmap, and a P0–P4 escalation framework adopted across 10+ cross-functional teams.' },
  { year: 'Nov 2024 – Oct 2025', role: 'Senior Digital Project Manager · Wide Eye', org: 'Creative agency', body: 'Led $2.6M+ of custom brand and web work across 10+ clients, running resourcing for blended teams and lifting efficiency 20%.' },
  { year: 'Nov 2023 – Nov 2024', role: 'Senior Digital Project Manager · Studio Simpatico', org: 'Creative agency', body: 'Managed 7+ web builds and 20 retainer clients, and led the change from Basecamp to Linear to raise team velocity.' },
];

const toolkit = [
  { label: 'Program & project management', style: 'outline', tags: ['Intake process design', 'Roadmap & backlog prioritization', 'Risk escalation (P0–P4)', 'KPI & status reporting', 'Resource & capacity planning', 'Change management', 'Budget management', 'Agile methodologies'] },
  { label: 'Tools', style: 'neutral', tags: ['Asana', 'Jira', 'Linear', 'Notion', 'Airtable', 'Confluence', 'Excel / MS Office'] },
  { label: 'Stakeholder & creative ops', style: 'outline', tags: ['Discovery workshops', 'Requirements gathering', 'Executive communication', 'Client onboarding', 'Cross-functional collaboration', 'Creative operations'] },
  { label: 'Documentation', style: 'neutral', tags: ['Functional specs', 'Acceptance criteria', 'Operational systems', 'Process documentation', 'SOW writing'] },
];
---
<BaseLayout title="About — Mingwei Ma" description="I'm Mingwei Ma, and I make delivery feel calm. Senior Project Manager with six years leading cross-functional delivery.">
  <Nav current="about" />

  <header class="wrap hero">
    <div>
      <Loop variant="double" class="hero-loop" />
      <Kicker text="About" />
      <h1>I'm Mingwei. I bridge the gap between big ideas and strict deadlines.</h1>
      <p class="lede">For over five years, I've been the person teams trust to handle their hardest, most tangled projects. Not because I have the fanciest framework, but because I earn their trust quickly and use it to keep everyone from product and engineering, to design, and leadership, moving in the same direction.</p>
    </div>
    <div>
      <ImagePlaceholder label="Drop your portrait" aspect="3/4" class="portrait" />
    </div>
  </header>

  <section class="wrap prose story">
    <p>My road to project management began back when high school group projects needed someone to build the color-coded schedule, empower each team member to contribute their part, and clear the path to deliver A+ work. Since then, I've spent over five years working my way up — from coordinating boutique brand and design projects to managing complex custom web builds at fast-paced agencies and startups.</p>
    <p>I quickly found that my favorite part of the work isn't the Gantt chart; it's the people and the cross-functional collaboration. Getting a skeptical engineer and an anxious client to align, spotting the quiet bottleneck before it breaks a timeline, and translating ambiguous client feedback into clear actionable items for a design team.</p>
    <p>I believe most project problems are trust and communication problems wearing schedule as a disguise. My approach leads with human connection, creating the baseline trust required for strict operational rigor to actually be effective.</p>
    <p>Lately, I've been deepening my technical and AI fluency by getting hands-on with tools like Claude Design and Claude Code to build things from scratch (including this website!). I don't want to just theorize about emerging tech; I want to speak my engineers' language, understand delivery friction firsthand, and actively find practical ways to leverage AI to make workflows faster and smarter for the whole team.</p>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <Loop d="M 4 14 C 20 22 30 30 40 30 C 54 30 54 12 40 12 C 28 12 30 28 46 28 C 60 28 68 22 88 14" />
      <Kicker text="What I bring" />
      <h2>The strengths behind the schedule.</h2>
    </div>
    <div class="values-grid">
      {values.map((v) => (
        <div class="card">
          <span class="card-kicker">{v.num}</span>
          <span class="card-title">{v.title}</span>
          <p class="card-body">{v.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap section" style="text-align: center;">
    <Kicker text="Credentials" />
    <div class="cred-row">
      {credentials.map((c, i) => (
        <span class={`tag ${i === 0 ? 'tag-outline' : 'tag-neutral'} cred-tag`}>{c}</span>
      ))}
    </div>
  </section>

  <section class="wrap section timeline-section">
    <div class="section-head">
      <Loop d="M 4 30 C 30 30 34 8 48 8 C 62 8 62 26 48 26 C 40 26 40 16 50 16 C 66 16 70 30 88 30" />
      <Kicker text="The path here" />
      <h2>Where I've done the work.</h2>
    </div>
    {timeline.map((t) => (
      <div class="tl-row">
        <span class="tl-year">{t.year}</span>
        <div>
          <div class="tl-role">{t.role}</div>
          <div class="tl-org">{t.org}</div>
          <p class="tl-body">{t.body}</p>
        </div>
      </div>
    ))}
  </section>

  <section class="wrap section toolkit-section">
    <div class="section-head">
      <Kicker text="Toolkit" />
      <h2>The skills behind the delivery.</h2>
    </div>
    <div class="toolkit-grid">
      {toolkit.map((group) => (
        <div>
          <div class="kick toolkit-label">{group.label}</div>
          <div class="toolkit-tags">
            {group.tags.map((t) => (
              <span class={`tag tag-${group.style}`}>{t}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="edu-row">
      <div class="edu-degree">B.S., International Trade &amp; Marketing</div>
      <div class="edu-school">Fashion Institute of Technology (SUNY) · Dec 2019</div>
    </div>
  </section>

  <ThreadRule />
  <section class="wrap cta-section">
    <div class="cta-band">
      <Loop variant="below" />
      <h2 class="cta-h2">Think we might be a fit?</h2>
      <a href="/contact" class="btn btn-primary cta-btn">Book a discovery call →</a>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .hero { display: grid; grid-template-columns: 1.3fr 1fr; gap: 56px; align-items: center; padding-top: 88px; padding-bottom: 72px; }
  .hero h1 { font-size: 52px; line-height: 1.08; margin: 20px 0 24px; font-weight: 400; }
  .hero-loop { margin: 0 0 var(--space-3); }
  .portrait { width: 100%; }

  .story { max-width: 720px; padding-top: 24px; }

  .section { padding-top: 80px; }
  .section-head { text-align: center; margin-bottom: var(--space-6); }
  .section-head h2 { font-size: 36px; margin-top: 14px; font-weight: 400; }

  .values-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }

  .cred-row { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: var(--space-4); }
  .cred-tag { font-size: 13px; padding: 6px 14px; }

  .timeline-section { max-width: 780px; }
  .tl-role { font-family: var(--font-heading); font-size: 21px; }
  .tl-org { font-size: 12.5px; font-family: var(--font-sans); letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-neutral-600); margin: 3px 0 6px; }
  .tl-body { font-size: 14px; line-height: 1.6; margin: 0; font-family: var(--font-body); color: color-mix(in srgb, var(--color-text) 78%, transparent); }

  .toolkit-section { max-width: 860px; }
  .toolkit-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-5) var(--space-8); }
  .toolkit-label { margin-bottom: var(--space-3); }
  .toolkit-tags { display: flex; flex-wrap: wrap; gap: 7px; }
  .edu-row { margin-top: var(--space-6); padding-top: var(--space-4); border-top: 1px solid var(--color-divider); display: flex; flex-wrap: wrap; gap: 4px 16px; align-items: baseline; justify-content: space-between; }
  .edu-degree { font-family: var(--font-heading); font-size: 20px; }
  .edu-school { font-size: 13px; font-family: var(--font-sans); color: var(--color-neutral-600); }

  .cta-section { padding-top: 0; text-align: center; }
  .cta-band { padding: 64px 0; }
  .cta-h2 { font-size: 42px; margin: 0 0 18px; font-weight: 400; }
  .cta-btn { font-size: 15px; padding: 13px 28px; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; padding-top: 56px; padding-bottom: 40px; text-align: center; }
    .hero h1 { font-size: 34px; }
    .portrait { max-width: 320px; margin: 0 auto; }
    .section { padding-top: 48px; }
    .values-grid { grid-template-columns: 1fr; }
    .tl-row { grid-template-columns: 1fr; }
    .toolkit-grid { grid-template-columns: 1fr; }
    .cta-h2 { font-size: 28px; }
  }
</style>
