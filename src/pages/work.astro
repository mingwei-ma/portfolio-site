---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Loop from '../components/Loop.astro';
import ThreadRule from '../components/ThreadRule.astro';
import Kicker from '../components/Kicker.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';

const cases = [
  {
    imageFirst: true,
    role: 'Founding Product Manager',
    company: 'SUBSCRIBE · Fintech SaaS',
    when: 'Oct 2025 – May 2026',
    tag: 'Founding PM · Program management',
    title: 'A company-wide program system, built from zero',
    situation: 'A fintech SaaS was running on 100+ unstructured boards with no shared intake or tracking. Requests reached engineering unvalidated, and leadership had no clear view of what was shipping.',
    whatIDid: ["I built the program management function from scratch in Asana — a structured intake process, a tiered access model, and clear tracking adopted across 10+ cross-functional teams. I owned the backlog, defined acceptance criteria and submission workflows, ran a P0–P4 escalation framework, and led kickoffs, sprint planning, and gate reviews with leadership. I also delivered a long-stalled pre-qualification feature by re-scoping it and leading QA through to launch."],
    stats: [
      { b: '100+→1', span: 'Boards to one system' },
      { b: '10+', span: 'Teams onboarded' },
      { b: 'P0–P4', span: 'Escalation framework' },
    ],
  },
  {
    imageFirst: false,
    role: 'Senior Digital PM',
    company: 'Wide Eye · Creative agency',
    when: 'Nov 2024 – Oct 2025',
    tag: 'Senior DPM · Delivery & resourcing',
    title: '$2.6M+ of brand and web work, delivered',
    situation: "Wide Eye's lead PM was leaving, and the agency needed someone who could ramp up fast and take over a blended team of designers and engineers running custom brand and web work across several high-profile projects, without missing a beat on delivery.",
    whatIDid: [
      "I owned day-to-day operations and resourcing in Harvest, Asana, Notion, and Airtable, running capacity planning, staffing, and workload balancing across projects while managing budgets and burn reports through the full lifecycle. I translated ambiguous stakeholder feedback into clear requirements, built reusable trackers and reporting templates adopted across the wider PM team, and automated status reporting in Slack that cut the time it took to pull a report in half.",
      "I also built content production and management templates to make client handoffs smoother, and started experimenting with AI tools for meeting notes and surfacing patterns in client feedback. When I spotted room to expand a client's scope, I worked with sales and the client directly to help shape it.",
    ],
    results: "My teams shipped $2.6M+ of brand and web work without burning out. Capacity was planned, budgets stayed predictable, and burn was visible weeks ahead instead of after the fact. The Slack automation and reporting templates became the team's default way of working, and half of my clients during that time expanded their scope or moved to a retainer.",
    stats: [
      { b: '$2.6M+', span: 'Delivered' },
      { b: '10+', span: 'Concurrent clients' },
      { b: '+20%', span: 'Team efficiency' },
    ],
  },
  {
    imageFirst: true,
    role: 'Senior Digital PM',
    company: 'Studio Simpatico · Creative agency',
    when: 'Nov 2023 – Nov 2024',
    tag: 'Senior DPM · Change management',
    title: 'How I Migrated Our Dev Team to Linear and Cut Handoff Times by a Full Week',
    situation: "Our agency was using Basecamp for both internal engineering work and external client communication. This shared setup created a serious liability: raw, internal technical debates and messy bug triaging were at risk of becoming visible to our clients. At the same time, Basecamp's minimalist feature set was holding our developers back. They needed a dedicated tool to run modern, agile sprints, but our monolithic workflow was capping their velocity and putting client trust at risk.",
    whatIDid: ["To fix the workflow bottleneck and secure our data, I led a zero-downtime migration to separate our client and internal communication tracks:"],
    bullets: [
      { label: 'Audited alternative platforms', text: "Researched Monday.com, Asana, Notion, and Airtable against our engineering team's lifecycle needs." },
      { label: 'Co-designed the new framework', text: 'Partnered directly with our Technical Architect and Lead Developer to build a high-velocity sprint system inside Linear.' },
      { label: 'Secured team buy-in', text: 'Pitched the strategic value to the agency owner and the design team, ensuring everyone was aligned on how the new tool ecosystem would function.' },
      { label: 'Established clear governance', text: 'Documented strict communication rules and handoff procedures to permanently separate internal development chat from client-facing spaces.' },
    ],
    results: "The migration completely eliminated the risk of clients seeing internal development notes. By tailoring the workflow to how our engineers actually work, we streamlined our QA ticket triage and made the handoff from design to development incredibly clean. Ultimately, this structural change compressed our handoff timelines by a full seven days and drastically improved our delivery precision.",
    stats: [
      { b: '-7 Days', span: 'Design-to-Dev Handoff Time' },
      { b: '0%', span: 'Exposed Internal Communications' },
      { b: 'Improved', span: 'Agile Sprint Adoption' },
    ],
  },
];
---
<BaseLayout title="Work — Mingwei Ma" description="Case studies from Mingwei Ma's work leading program and delivery management at SUBSCRIBE, Wide Eye, and Studio Simpatico.">
  <Nav current="work" />

  <header class="wrap hero">
    <Loop variant="double" />
    <Kicker text="Selected work" />
    <h1>The roles, and what I built in them.</h1>
    <p class="lede">Three recent engagements — the scope, what I did, and what changed. The short version lives on my <a href="/assets/Mingwei-Ma-Resume.pdf" target="_blank">résumé</a>.</p>
  </header>

  {cases.map((c, i) => (
    <>
      <section class="wrap case case-section" style={i === 0 ? 'padding-top: 40px;' : 'padding-top: 72px;'}>
        <div class="case-grid" style={`grid-template-columns: ${c.imageFirst ? '1fr 1.1fr' : '1.1fr 1fr'};`}>
          {c.imageFirst && (
            <div>
              <ImagePlaceholder label="Project image (optional)" aspect="4/3" />
              <div class="meta-table">
                <div class="meta-row"><span class="meta-label">Role</span><span class="meta-value">{c.role}</span></div>
                <div class="meta-row"><span class="meta-label">Company</span><span class="meta-value">{c.company}</span></div>
                <div class="meta-row meta-row-last"><span class="meta-label">When</span><span class="meta-value">{c.when}</span></div>
              </div>
            </div>
          )}
          <div>
            <span class="tag tag-outline">{c.tag}</span>
            <h2 class="case-title">{c.title}</h2>
            <p><strong>The situation.</strong> {c.situation}</p>
            <p><strong>What I did.</strong> {c.whatIDid[0]}</p>
            {c.whatIDid.slice(1).map((p) => <p>{p}</p>)}
            {c.bullets && (
              <ul class="case-list">
                {c.bullets.map((b) => <li><strong>{b.label}:</strong> {b.text}</li>)}
              </ul>
            )}
            {c.results && <p><strong>The results.</strong> {c.results}</p>}
            <div class="result-row">
              {c.stats.map((s) => (
                <div class="result-stat"><b>{s.b}</b><span>{s.span}</span></div>
              ))}
            </div>
          </div>
          {!c.imageFirst && (
            <div>
              <ImagePlaceholder label="Project image (optional)" aspect="4/3" />
              <div class="meta-table">
                <div class="meta-row"><span class="meta-label">Role</span><span class="meta-value">{c.role}</span></div>
                <div class="meta-row"><span class="meta-label">Company</span><span class="meta-value">{c.company}</span></div>
                <div class="meta-row meta-row-last"><span class="meta-label">When</span><span class="meta-value">{c.when}</span></div>
              </div>
            </div>
          )}
        </div>
      </section>
      {i < cases.length - 1 && <ThreadRule />}
    </>
  ))}

  <section class="wrap testi-band">
    <blockquote class="testi-quote">"Mingwei was fantastic. I wish she could manage all my projects and my whole life. I couldn't have worked with a better team."</blockquote>
    <div class="testi-attr">Communications Consultant · Girl Be Heard</div>
  </section>

  <section class="wrap cta-section">
    <Loop variant="flourish" />
    <h2 class="cta-h2">Want this kind of delivery on your team?</h2>
    <div class="cta-ctas">
      <a href="/contact" class="btn btn-primary cta-btn">Get in touch →</a>
      <a href="/assets/Mingwei-Ma-Resume.pdf" target="_blank" class="btn btn-secondary cta-btn">Download résumé</a>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .hero { text-align: center; padding-top: 88px; padding-bottom: 56px; max-width: 720px; }
  .hero h1 { font-size: 52px; line-height: 1.08; margin: 20px 0 22px; font-weight: 400; }

  .case-grid { display: grid; gap: 48px; align-items: start; padding-top: var(--space-6); border-top: 1px solid var(--color-divider); }
  .case-title { font-size: 30px; margin: 14px 0 12px; font-weight: 400; }

  .meta-table { margin-top: var(--space-4); display: grid; gap: 10px; font-size: 13px; font-family: var(--font-sans); }
  .meta-row { display: flex; justify-content: space-between; gap: 12px; padding-bottom: 8px; border-bottom: 1px solid var(--color-divider); }
  .meta-row-last { border-bottom: none; padding-bottom: 0; }
  .meta-label { color: var(--color-neutral-600); text-transform: uppercase; letter-spacing: 0.08em; font-size: 11px; }
  .meta-value { font-family: var(--font-heading); font-size: 15px; }

  .result-row { display: flex; gap: var(--space-6); margin-top: var(--space-4); padding-top: var(--space-3); border-top: 1px solid var(--color-divider); flex-wrap: wrap; }

  .case-list { margin: 10px 0 0; padding-left: 20px; }
  .case-list li { font-size: 15px; line-height: 1.68; font-family: var(--font-body); color: color-mix(in srgb, var(--color-text) 82%, transparent); margin-bottom: 8px; }

  .testi-band { padding-top: 88px; text-align: center; max-width: 780px; }
  .testi-quote { margin: 0; font-family: var(--font-heading); font-size: 30px; line-height: 1.28; font-weight: 400; padding: var(--space-6) 0; border-top: 1px solid var(--color-divider); border-bottom: 1px solid var(--color-divider); }
  .testi-attr { font-size: 13px; font-family: var(--font-sans); letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-neutral-600); margin-top: var(--space-3); }

  .cta-section { padding-top: 88px; text-align: center; }
  .cta-h2 { font-size: 42px; margin: 0 0 18px; font-weight: 400; }
  .cta-ctas { display: flex; gap: var(--space-3); justify-content: center; flex-wrap: wrap; }
  .cta-btn { font-size: 15px; padding: 13px 28px; }

  @media (max-width: 860px) {
    .hero { padding-top: 56px; padding-bottom: 40px; }
    .hero h1 { font-size: 34px; }
    .case-grid { grid-template-columns: 1fr !important; gap: 24px; }
    .case-section { padding-top: 40px !important; }
    .testi-band { padding-top: 56px; }
    .testi-quote { font-size: 22px; }
    .cta-section { padding-top: 56px; }
    .cta-h2 { font-size: 28px; }
  }
</style>
