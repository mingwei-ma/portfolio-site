---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Loop from '../components/Loop.astro';
import ThreadRule from '../components/ThreadRule.astro';
import Kicker from '../components/Kicker.astro';
import LogoWall from '../components/LogoWall.astro';
import ServicesTabs from '../components/ServicesTabs.astro';
import { letters } from '../lib/letters';
import { homeServices, homeWork, testimonials } from '../lib/homeContent';

const faqs = [
  { q: 'What kind of teams fit you best?', a: 'Strategic and creative tech organizations where I get to work with talented doers from multiple disciplines. Teams that push each other to new limits to create unique experiences that delight.' },
  { q: 'Which tools and methods do you use?', a: "Asana, Jira, Linear, Notion, Airtable, and Confluence, among others. I'm methodology-agnostic (Agile and Scrum where they fit, something lighter where they don't) and I shape process to the work, not the other way around." },
  { q: 'Do you hold any certifications (PMP, CSM)?', a: "I'm PMP certified, backed by over five years of hands-on product and project delivery." },
  { q: 'How does AI fit into how you work?', a: "I'm actively building my technical and AI fluency, including prototyping tools with Claude Code and Design so I can speak my engineers' language and put AI to work sensibly on planning, reporting, and the busywork around delivery. Check out what I'm building here!" },
];
---
<BaseLayout title="Mingwei Ma — Product Manager" description="The thread that holds everything together. Portfolio of Mingwei Ma, Product Manager.">
  <Nav current="home" />

  <header class="wrap hero">
    <Loop variant="above" />
    <Kicker text="Product Manager, PMP" />
    <h1>The thread that holds everything together.</h1>
    <p class="lede hero-lede">Product manager with 5+ years turning customer and business needs into shipped features across financial services, technology, and nonprofits. I write the requirements, align design, engineering, and stakeholders, and stay through launch and the learning that follows.</p>
    <div class="hero-ctas">
      <a href="/product" class="btn btn-primary hero-btn"><span class="btn-label">Explore product work →</span></a>
      <a href="/program" class="btn btn-primary hero-btn"><span class="btn-label">Explore program &amp; project leadership →</span></a>
    </div>
  </header>

  <div class="wrap">
    <div class="marquee">
      <span>Product management</span><span class="dot">·</span>
      <span>Requirements &amp; PRDs</span><span class="dot">·</span>
      <span>Roadmap &amp; backlog</span><span class="dot">·</span>
      <span>Launch readiness</span><span class="dot">·</span>
      <span>KPIs &amp; analytics</span><span class="dot">·</span>
      <span>Program delivery</span>
    </div>
    <div class="stats">
      <div class="stat"><div class="stat-num" style="--circle: url('/assets/stat-circle-pink.png'); font-size: 56px;">5+</div><div class="stat-label">Years shipping digital products</div></div>
      <div class="stat"><div class="stat-num" style="--circle: url('/assets/stat-circle-yellow.png'); font-size: 46px;">50%</div><div class="stat-label">More on-time feature releases</div></div>
      <div class="stat"><div class="stat-num" style="--circle: url('/assets/stat-circle-orange.png'); font-size: 56px;">30</div><div class="stat-label">Days to relaunch a stalled 3-year initiative</div></div>
    </div>
  </div>

  <LogoWall />

  <section class="wrap section">
    <div class="section-head">
      <Kicker text="What I do" />
      <h2>Where I create leverage for a team.</h2>
    </div>
    <ServicesTabs items={homeServices} />
  </section>

  <section class="wrap section">
    <div class="work-head">
      <div>
        <Kicker text="Selected work" />
        <h2 style="font-size: 34px; margin-top: 12px;">A few things I've landed.</h2>
      </div>
      <a href="/work/product" class="btn btn-ghost hover-rainbow"><span>{letters('All case studies').map((c) => (typeof c === 'string' ? <span>{c}</span> : <span> </span>))} →</span></a>
    </div>
    <div class="work-grid">
      {homeWork.map((w) => (
        <a href={w.href ?? `/work/project#${w.slug}`} class="card work-card">
          <span class="card-kicker">{w.kicker}</span>
          <span class={`card-title ${w.highlight ? 'has-highlight' : ''}`} style={w.highlight ? `--highlight: url('${w.highlight}');` : undefined}>{w.title}</span>
          <p class="card-body">{w.body}</p>
          <span class="card-meta" style="color: var(--color-accent);">{w.cta ?? 'Read case →'}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap section">
    <ThreadRule />
    <div style="text-align: center; margin-bottom: var(--space-6);"><Kicker text="Kind words" /></div>
    <div class="testi-grid">
      {testimonials.map((t) => (
        <figure>
          <blockquote class="testi-quote" set:html={t.quote} />
          <figcaption class="testi-attr">{t.attr}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <Kicker text="What's next" />
      <h2>What I'm looking for next.</h2>
    </div>
    <div class="next-grid">
      <div class="card next-card">
        <span class="card-kicker">The role</span>
        <span class="card-title next-title">Product manager</span>
        <p class="card-body next-body">Owning a product area end to end: turning customer and business needs into clear requirements, prioritizing the backlog, and partnering with design and engineering through launch and iteration.</p>
      </div>
      <div class="card next-card">
        <span class="card-kicker">The team</span>
        <span class="card-title next-title">Product &amp; technology teams</span>
        <p class="card-body next-body">Teams building digital products in financial services, technology, and mission-driven organizations, who need a PM who can turn ambiguity into something real.</p>
      </div>
      <div class="card next-card">
        <span class="card-kicker">The setup</span>
        <span class="card-title next-title">Full-time, contract &amp; fractional</span>
        <p class="card-body next-body">Based in NYC, I'd prefer remote-first or hybrid roles. Open to full-time roles, as well as contract or fractional work for the right fit.</p>
      </div>
    </div>
  </section>

  <section class="wrap section faq-section">
    <img src="/assets/faq-divider.png" alt="" class="faq-divider" />
    <div class="section-head">
      <Kicker text="Questions" />
      <h2>Good to know.</h2>
    </div>
    {faqs.map((f) => (
      <div class="faq-row">
        <div class="faq-q">{f.q}</div>
        <p class="faq-a">{f.a}</p>
      </div>
    ))}
  </section>

  <section class="wrap section cta-section">
    <div class="cta-band">
      <Loop variant="below" />
      <Kicker text="Let's talk" />
      <h2 class="cta-h2">Hiring for a role I'd fit?</h2>
      <p class="lede cta-lede">I'd love to hear about the team and the work. Send a note, or take my résumé with you.</p>
      <div class="cta-ctas">
        <a href="/contact" class="btn btn-primary cta-btn"><span class="btn-label">Get in touch →</span></a>
        <a href="/assets/Mingwei-Ma-Resume.pdf" target="_blank" class="btn btn-ghost cta-btn cta-btn-icon hover-rainbow">
          <span>{letters('Download résumé').map((c) => (typeof c === 'string' ? <span>{c}</span> : <span> </span>))}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        </a>
      </div>
    </div>
  </section>

  <Footer bordered={false} />
</BaseLayout>

<style>
  .hero { text-align: center; padding-top: 84px; padding-bottom: 64px; }
  .hero h1 { font-size: 60px; line-height: 1.07; margin: 22px 0; font-weight: 400; }
  .hero-lede { max-width: 720px; margin: 0 auto; }
  .hero-ctas { display: flex; align-items: flex-start; gap: var(--space-3); justify-content: center; margin-top: 38px; flex-wrap: wrap; }
  .hero-btn { font-size: 14px; padding: 12px 24px; }

  .marquee {
    display: flex; flex-wrap: wrap; gap: 10px 22px; justify-content: center;
    font-family: var(--font-nav); font-weight: 500; font-size: 12px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--color-neutral-700);
    padding: 26px 0; border-top: 1px solid var(--color-divider); border-bottom: 1px solid var(--color-divider);
  }
  .marquee .dot { color: var(--color-accent); }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); padding: 40px 0 32px; text-align: center; }
  .stat-num {
    position: relative; isolation: isolate;
    display: flex; align-items: center; justify-content: center;
    width: 116px; height: 116px; margin: 0 auto 20px;
    font-family: var(--font-script); font-weight: 400;
  }
  .stat-num::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background-image: var(--circle); background-size: contain;
    background-position: center; background-repeat: no-repeat;
  }
  .stat-label { font-size: 12px; font-family: var(--font-nav); font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-neutral-600); margin-top: 6px; }

  .section { padding-top: 90px; }
  .section-head { text-align: center; margin-bottom: var(--space-6); }
  .section-head h2 { font-size: 38px; margin-top: 14px; font-weight: 400; }
  .work-head { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: var(--space-4); border-bottom: 1px solid var(--color-divider); padding-bottom: var(--space-3); flex-wrap: wrap; gap: var(--space-3); }
  .work-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  .work-card { text-decoration: none; color: inherit; border: none; padding: var(--space-3) 0; }
  .work-card .card-title { text-transform: none; letter-spacing: normal; }
  .work-card .card-title.has-highlight {
    align-self: flex-start;
    background-image: var(--highlight);
    background-repeat: no-repeat;
    background-position: center;
    background-size: 100% 100%;
    padding: 3px 8px;
    margin: -3px -8px 5px -8px;
  }
  .work-card .card-meta { position: relative; align-self: flex-start; padding-bottom: 8px; transition: transform 0.25s ease; }
  .work-card .card-meta::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 7px;
    background-image: url('/assets/cta-underline.png');
    background-size: 100% 100%; background-position: center; background-repeat: no-repeat;
    opacity: 0; transition: opacity 0.25s ease;
  }
  .work-card:hover .card-meta { transform: translateY(-1px); }
  .work-card:hover .card-meta::after { opacity: 1; }

  .testi-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-8) var(--space-6); align-items: start; }
  .testi-quote { margin: 0; font-family: var(--font-body); font-size: 22px; line-height: 1.45; font-weight: 400; }
  .testi-attr { font-size: 11px; font-family: var(--font-nav); letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-neutral-600); margin-top: var(--space-3); }

  .next-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  .next-card { padding: var(--space-4); }
  .next-title { font-size: 17px; text-transform: none; letter-spacing: normal; }
  .next-body { font-size: 14px; }

  .faq-section { max-width: 760px; }
  .faq-divider { width: 100%; height: auto; display: block; margin: 0 auto var(--space-6); border-radius: var(--radius-md); }

  .cta-section { padding-top: 96px; text-align: center; }
  .cta-band {
    padding: 110px 48px;
    border-radius: var(--radius-lg);
    background-color: #f0e9df;
    background-image: url('/assets/cta-bg.jpg');
    background-size: cover;
    background-position: center;
  }
  .cta-h2 { font-size: 46px; margin: 18px 0; font-weight: 400; }
  .cta-lede { max-width: 520px; margin: 0 auto var(--space-6); }
  .cta-ctas { display: flex; align-items: flex-start; gap: var(--space-3); justify-content: center; flex-wrap: wrap; }
  .cta-btn { font-size: 15px; padding: 13px 28px; }
  .cta-btn-icon { display: inline-flex; align-items: center; gap: 8px; }

  @media (max-width: 860px) {
    .hero { padding-top: 56px; padding-bottom: 44px; }
    .hero h1 { font-size: 38px; margin: 18px 0; }
    .stats { grid-template-columns: 1fr; gap: var(--space-4); }
    .work-grid { grid-template-columns: 1fr; }
    .testi-grid { grid-template-columns: 1fr; gap: var(--space-6); }
    .next-grid { grid-template-columns: 1fr; }
    .section { padding-top: 56px; }
    .cta-h2 { font-size: 32px; }
    .cta-band { padding: 52px 24px; }
  }
</style>
